<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>app.bud.companion</string>
	<key>CFBundleName</key>
	<string>bud</string>
	<key>CFBundleDisplayName</key>
	<string>bud</string>
	<key>CFBundleExecutable</key>
	<string>bud</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<!-- A menu-bar app: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Hold-to-talk: speech is transcribed on this Mac and never uploaded. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>bud listens only while you hold the talk key, and turns your words into text on this Mac.</string>
	<!-- Names from Contacts help bud spell the people you mention. -->
	<key>NSContactsUsageDescription</key>
	<string>bud reads the names in your contacts so it spells the people you mention correctly. Nothing leaves this Mac.</string>
	<!-- bud runs on this Mac over plain HTTP; allow loopback only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
