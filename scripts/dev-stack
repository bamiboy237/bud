#!/usr/bin/env -S uv run python
"""Run a private bud server and Mac app from this checkout, screenshot it, and tear it down.

    scripts/dev-stack up              real accounts: copies your Composio bindings
    scripts/dev-stack up --simulate   simulated inbox and calendar
    scripts/dev-stack up --no-app     server only, no Mac build
    scripts/dev-stack shot idle       full screen to data/tmp/dev-stack/shots/idle.png
    scripts/dev-stack shot card --rect 1020,280,420,620
    scripts/dev-stack status
    scripts/dev-stack down            stops both and deletes the stack's data folder

Each stack gets its own data folder and a free port, so it runs beside the live server on
8420 and beside stacks in other checkouts. `down` stops only the processes it started.

The ChatGPT login is not copied: bud lets one process at a time use it, and a copy that
refreshed its token could sign out the live server. Real mode uses the API keys in `.env`.
"""

import argparse
import contextlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

import httpx

ROOT = Path(__file__).resolve().parent.parent
STACK = ROOT / "data" / "tmp" / "dev-stack"
STATE = STACK / "state.json"
DATA = STACK / "data"
SHOTS = STACK / "shots"
APP = ROOT / "mac" / "build" / "bud.app" / "Contents" / "MacOS" / "bud"


def real_data_dir() -> Path:
    """The owner's data folder: DATA_DIR, else data/ in the main checkout.

    Managed checkouts link `.env` to the main checkout, so its real location finds it.
    """
    if os.environ.get("DATA_DIR"):
        return Path(os.environ["DATA_DIR"]).expanduser()
    return (ROOT / ".env").resolve().parent / "data"


def alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def load() -> dict:
    return json.loads(STATE.read_text()) if STATE.exists() else {}


def free_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def spawn(command: list[str], env: dict[str, str], log: Path) -> int:
    out = os.fdopen(os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "a")
    process = subprocess.Popen(
        command, cwd=ROOT, env=env, stdout=out, stderr=out, start_new_session=True
    )
    return process.pid


def up(simulate: bool, app: bool) -> None:
    state = load()
    if alive(state.get("server_pid")) or alive(state.get("app_pid")):
        sys.exit(f"A stack is running on port {state['port']}. Run `scripts/dev-stack down`.")
    if DATA.exists():
        shutil.rmtree(DATA)
    DATA.mkdir(parents=True, mode=0o700)
    if not simulate:
        source = real_data_dir() / "composio"
        if not source.is_dir():
            sys.exit(f"No Composio bindings at {source}. Connect accounts with `bud serve` first.")
        shutil.copytree(source, DATA / "composio")
    if app:
        subprocess.run([str(ROOT / "mac" / "build.sh")], cwd=ROOT, check=True)

    port = free_port()
    env = {**os.environ, "DATA_DIR": str(DATA), "PYDANTIC_AI_NO_BANNER": "1"}
    code = (
        "import uvicorn; from bud.core.server import create_app; "
        f"uvicorn.run(create_app(simulate={simulate}), host='127.0.0.1', port={port}, "
        "log_level='warning', timeout_graceful_shutdown=3)"
    )
    server = spawn([sys.executable, "-c", code], env, DATA / "server.log")
    state = {"port": port, "server_pid": server, "mode": "simulate" if simulate else "real"}
    STATE.write_text(json.dumps(state, indent=1))
    for _ in range(120):
        if not alive(server):
            sys.exit(f"Server exited; see {DATA / 'server.log'}")
        with contextlib.suppress(httpx.HTTPError):
            if httpx.get(f"http://127.0.0.1:{port}/runtime", timeout=2).status_code == 401:
                break
        time.sleep(1)
    else:
        stop_group(server)
        STATE.unlink()
        sys.exit(f"Server did not start; see {DATA / 'server.log'}")

    if app:
        app_env = {**env, "BUD_URL": f"http://127.0.0.1:{port}", "BUD_HOME": str(ROOT)}
        state["app_pid"] = spawn([str(APP)], app_env, DATA / "app.log")
        STATE.write_text(json.dumps(state, indent=1))
    print(f"up: {state['mode']} server on http://127.0.0.1:{port}, data {DATA}")
    if app:
        print(f"app: pid {state['app_pid']}, log {DATA / 'app.log'}")


def shot(name: str, rect: str | None) -> None:
    SHOTS.mkdir(parents=True, exist_ok=True)
    path = SHOTS / f"{name}.png"
    command = ["screencapture", "-x", *(["-R", rect] if rect else []), str(path)]
    subprocess.run(command, check=True)
    print(path)


def stop_group(pid: int | None) -> None:
    if not alive(pid):
        return
    with contextlib.suppress(ProcessLookupError, PermissionError):
        os.killpg(pid, signal.SIGTERM)
        # The server holds bud.lock until shutdown ends; wait so the next `up` can start.
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            os.killpg(pid, 0)
            time.sleep(0.2)
        os.killpg(pid, signal.SIGKILL)


def down() -> None:
    state = load()
    stop_group(state.get("app_pid"))
    stop_group(state.get("server_pid"))
    STATE.unlink(missing_ok=True)
    if DATA.exists():
        shutil.rmtree(DATA)
    print("down")


def status() -> None:
    state = load()
    if not state:
        print("no stack")
        return
    for key in ("server_pid", "app_pid"):
        if key in state:
            state[key.removesuffix("_pid")] = "running" if alive(state[key]) else "stopped"
    print(json.dumps(state, indent=1))


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="scripts/dev-stack", description=__doc__, formatter_class=argparse.RawTextHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("up", help="build the app, start a private server, launch the app")
    start.add_argument("--simulate", action="store_true", help="simulated inbox and calendar")
    start.add_argument("--no-app", action="store_true", help="start the server only")
    capture = commands.add_parser("shot", help="save a screenshot under data/tmp/dev-stack/shots")
    capture.add_argument("name")
    capture.add_argument("--rect", help="x,y,width,height in screen points")
    commands.add_parser("status", help="show the running stack")
    commands.add_parser("down", help="stop the stack and delete its data folder")
    args = parser.parse_args()
    if args.command == "up":
        up(args.simulate, not args.no_app)
    elif args.command == "shot":
        shot(args.name, args.rect)
    elif args.command == "status":
        status()
    else:
        down()


if __name__ == "__main__":
    main()
