#!/usr/bin/env -S uv run python
"""Run a private bud server and Mac app from this checkout, screenshot it, and tear it down.

    scripts/dev-stack up              real accounts: snapshots your Composio bindings
    scripts/dev-stack up --simulate   simulated inbox and calendar
    scripts/dev-stack up --no-app     server only, no Mac build
    scripts/dev-stack shot idle       full screen to data/tmp/dev-stack/shots/idle.png
    scripts/dev-stack shot card --rect 1020,280,420,620
    scripts/dev-stack status
    scripts/dev-stack down            stops both and deletes the stack's data folder

Each stack gets its own data folder and a free port, so it runs beside the live server on
8420 and beside stacks in other checkouts. `down` stops only the processes it started.

Real mode copies only the account bindings, never the live sessions or pending runs, so
nothing the live server owes can run twice. It leaves out the ChatGPT login, since a copy
that refreshed its token could sign out the live server, and uses the API keys in `.env`.
iMessage (Photon) stays off, so owner messages keep going to the live server.
"""

import argparse
import json
import os
import shutil
import socket
import sqlite3
import subprocess
import sys
from contextlib import closing
from pathlib import Path

from bud.config import Settings
from bud.evals.sim import launch_server, stop_process_group

ROOT = Path(__file__).resolve().parent.parent
STACK = ROOT / "data" / "tmp" / "dev-stack"
STATE = STACK / "state.json"
DATA = STACK / "data"
SHOTS = STACK / "shots"
APP = ROOT / "mac" / "build" / "bud.app" / "Contents" / "MacOS" / "bud"
NO_PHOTON = {
    "PHOTON_API_KEY": "",
    "PHOTON_PROJECT_ID": "",
    "PHOTON_OWNER_HANDLE": "",
    "PHOTON_AGENT_HANDLE": "",
}


def live_data_dir() -> Path:
    """The live server's data folder, read the way the server reads it.

    Managed checkouts link `.env` to the main checkout, where the live server runs, so a
    relative DATA_DIR is resolved from there.
    """
    main_checkout = (ROOT / ".env").resolve().parent
    data_dir = Settings(_env_file=main_checkout / ".env").data_dir.expanduser()
    return data_dir if data_dir.is_absolute() else main_checkout / data_dir


def snapshot_bindings(target: Path) -> None:
    source = live_data_dir() / "composio" / "connections.db"
    if not source.is_file():
        sys.exit(f"No Composio bindings at {source}. Connect accounts with `bud serve` first.")
    target.mkdir(mode=0o700)
    # The backup API gives a consistent copy while the live server has the database open.
    with (
        closing(sqlite3.connect(f"file:{source}?mode=ro", uri=True)) as live,
        closing(sqlite3.connect(target / "connections.db")) as copy,
    ):
        live.backup(copy)


def alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def load() -> dict:
    return json.loads(STATE.read_text()) if STATE.exists() else {}


def save(state: dict) -> None:
    STATE.write_text(json.dumps(state, indent=1))


def free_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def up(simulate: bool, app: bool) -> None:
    state = load()
    if alive(state.get("server_pid")) or alive(state.get("app_pid")):
        sys.exit(f"A stack is running on port {state['port']}. Run `scripts/dev-stack down`.")
    if DATA.exists():
        shutil.rmtree(DATA)
    DATA.mkdir(parents=True, mode=0o700)
    if not simulate:
        snapshot_bindings(DATA / "composio")
    if app:
        subprocess.run([str(ROOT / "mac" / "build.sh")], cwd=ROOT, check=True)

    port = free_port()
    server = launch_server(DATA, port, simulate=simulate, env=NO_PHOTON)
    state = {"port": port, "server_pid": server, "mode": "simulate" if simulate else "real"}
    save(state)
    print(f"up: {state['mode']} server on http://127.0.0.1:{port}, data {DATA}")

    if app:
        env = {**os.environ, "BUD_URL": f"http://127.0.0.1:{port}", "BUD_HOME": str(ROOT)}
        env["DATA_DIR"] = str(DATA)
        log = os.open(DATA / "app.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        process = subprocess.Popen(
            [str(APP)], cwd=ROOT, env=env, stdout=log, stderr=log, start_new_session=True
        )
        os.close(log)
        state["app_pid"] = process.pid
        save(state)
        print(f"app: pid {process.pid}, log {DATA / 'app.log'}")


def shot(name: str, rect: str | None) -> None:
    SHOTS.mkdir(parents=True, exist_ok=True)
    path = SHOTS / f"{name}.png"
    command = ["screencapture", "-x", *(["-R", rect] if rect else []), str(path)]
    subprocess.run(command, check=True)
    print(path)


def down() -> None:
    state = load()
    for key in ("app_pid", "server_pid"):
        if alive(state.get(key)):
            stop_process_group(state[key])
    STATE.unlink(missing_ok=True)
    if DATA.exists():
        shutil.rmtree(DATA)
    print("down")


def status() -> None:
    state = load()
    if not state:
        print("no stack")
        return
    for key in ("server_pid", "app_pid"):
        if key in state:
            state[key.removesuffix("_pid")] = "running" if alive(state[key]) else "stopped"
    print(json.dumps(state, indent=1))


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="scripts/dev-stack", description=__doc__, formatter_class=argparse.RawTextHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("up", help="build the app, start a private server, launch the app")
    start.add_argument("--simulate", action="store_true", help="simulated inbox and calendar")
    start.add_argument("--no-app", action="store_true", help="start the server only")
    capture = commands.add_parser("shot", help="save a screenshot under data/tmp/dev-stack/shots")
    capture.add_argument("name")
    capture.add_argument("--rect", help="x,y,width,height in screen points")
    commands.add_parser("status", help="show the running stack")
    commands.add_parser("down", help="stop the stack and delete its data folder")
    args = parser.parse_args()
    if args.command == "up":
        up(args.simulate, not args.no_app)
    elif args.command == "shot":
        shot(args.name, args.rect)
    elif args.command == "status":
        status()
    else:
        down()


if __name__ == "__main__":
    main()
