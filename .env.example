# Copy to .env and fill in. .env is gitignored; this file is not.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# There is no backend setting. `bud serve --simulate` uses the simulated inbox and
# calendar. Plain `bud serve` uses the accounts you linked with `bud connect`.
# Optional, off by default. In balanced approval mode, a decision model (OpenAI Decisions API,
# uses OPENAI_API_KEY) scores each reversible write and skips the approval prompt only when it
# is confident the call matches your request. Sends and real-account writes always ask.
# DECISION_AUTO_ALLOW=true
# DECISION_THRESHOLD=0.9
