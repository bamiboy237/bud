# Copy to .env and fill in. .env is gitignored; this file is not.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# There is no backend setting. `bud serve --simulate` uses the simulated inbox and
# calendar. Plain `bud serve` uses the accounts you linked with `bud connect`.
# Auto approval mode (the default) reviews each reversible write with OpenAI's Decisions API
# (uses OPENAI_API_KEY): the tool call and your request are sent there, and a call runs only
# when the reviewer judges it safe and clearly requested. Sends, real-account writes, and skill
# installs always ask. Set this to false to keep that data off the API; auto mode then asks
# about every write, like strict.
# APPROVAL_REVIEW=false
# APPROVAL_REVIEW_MODEL=gpt-6-luna
